# Cloudflare Pages & Resend Environment Variables Example
# Copy to .env for local testing or configure in Cloudflare Pages Dashboard -> Settings -> Environment Variables

# Resend API Key for sending notification emails to contact@gmdesign.in
RESEND_API_KEY=re_your_api_key_here

# Cloudflare Turnstile CAPTCHA keys (optional in local dev, recommended in production)
TURNSTILE_SITE_KEY=0x4AAAAAAAc_your_site_key_here
TURNSTILE_SECRET_KEY=0x4AAAAAAAc_your_secret_key_here

# Destination email for form submissions
CONTACT_EMAIL=contact@gmdesign.in
