---
import { siteConfig } from '../config/site';
import Button from './Button.astro';
import ContactForm from './ContactForm.astro';

interface Props {
  headline?: string;
  subheadline?: string;
  showForm?: boolean;
  class?: string;
}

const {
  headline = 'Not sure if AI fits your business? Tell us what slows your team down.',
  subheadline = 'We will evaluate your workflow and tell you honestly if an AI agent is right, or if a simple spreadsheet / form already solves it.',
  showForm = true,
  class: className = '',
} = Astro.props;

const bookingHref = siteConfig.bookingUrl.startsWith('http')
  ? siteConfig.bookingUrl
  : siteConfig.defaultBookingHref;
---

<section
  class:list={[
    'rounded-xl border border-border bg-surface-soft p-5 sm:p-10 lg:p-12',
    className,
  ]}
  aria-labelledby="cta-band-heading"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Left text -->
    <div class:list={[showForm ? 'lg:col-span-6' : 'lg:col-span-8 mx-auto text-center']}>
      <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-accent bg-accent-soft border border-blue-100 px-2 py-0.5 rounded inline-block mb-2.5">
        Zero Sales Pressure
      </span>
      <h2
        id="cta-band-heading"
        class="text-lg sm:text-xl lg:text-2xl font-bold tracking-tight text-ink leading-snug"
      >
        {headline}
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-body leading-relaxed">
        {subheadline}
      </p>

      <div class="mt-4 sm:mt-5 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
        <Button href={bookingHref} variant="primary" size="md" class="text-center justify-center">
          Book a free 30-minute call
        </Button>
        <a
          href={siteConfig.whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 text-xs sm:text-sm font-semibold text-ink hover:text-accent min-h-tap py-2.5 px-3 bg-surface rounded-md border border-border"
        >
          <span>Prefer WhatsApp? Message us</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-ink-muted">
        <span class="inline-flex items-center gap-1">
          <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
          </svg>
          No automated pitches
        </span>
        <span class="inline-flex items-center gap-1">
          <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
          </svg>
          Reply in 1 working day
        </span>
      </div>
    </div>

    <!-- Right: Quick 3-field contact form -->
    {showForm && (
      <div class="lg:col-span-6 bg-surface p-4 sm:p-7 rounded-lg border border-border shadow-card">
        <h3 class="text-sm sm:text-base font-bold text-ink mb-1">
          Quick enquiry (reply in 1 working day)
        </h3>
        <p class="text-xs text-ink-muted mb-3 sm:mb-4">
          No endless forms. 3 fields only.
        </p>
        <ContactForm compact={true} />
      </div>
    )}
  </div>
</section>
