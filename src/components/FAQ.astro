---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class:list={['space-y-3 sm:space-y-4 max-w-prose mx-auto', className]}>
  {
    items.map((item) => (
      <details
        class="group border border-border rounded-lg bg-surface overflow-hidden transition-colors duration-180 hover:border-slate-300 open:border-accent open:bg-surface-soft/40"
      >
        <summary
          class="flex items-center justify-between gap-3 p-3.5 sm:p-5 cursor-pointer font-semibold text-ink text-sm sm:text-base select-none list-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
        >
          <span>{item.question}</span>
          <span class="shrink-0 w-6 h-6 rounded-full bg-surface-soft border border-border flex items-center justify-center text-ink-muted group-open:rotate-180 transition-transform duration-180">
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>
        <div class="px-3.5 sm:px-5 pb-4 sm:pb-5 text-xs sm:text-sm text-body leading-relaxed border-t border-transparent group-open:border-border/60 pt-1">
          <p set:html={item.answer} />
        </div>
      </details>
    ))
  }
</div>

<style>
  /* Remove default webkit marker */
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
