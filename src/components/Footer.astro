---
import { siteConfig, navItems, serviceDropdown } from '../config/site';
import PlaceholderChip from './PlaceholderChip.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-surface-soft border-t border-border mt-auto overflow-hidden" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: About & Trust -->
      <div class="space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded bg-ink flex items-center justify-center text-white font-bold text-base shrink-0">
            GM
          </div>
          <span class="text-xl font-bold tracking-tight text-ink">GM Design</span>
        </div>
        <p class="text-xs sm:text-sm text-body leading-relaxed max-w-sm">
          AI as a service and proven web systems for Indian businesses. We build practical WhatsApp agents, document workflows, and high-trust websites.
        </p>
        <div class="pt-2 text-xs text-ink-muted space-y-1.5">
          <div class="flex flex-wrap items-center gap-1.5">
            <span>Operating since:</span>
            <strong class="text-ink">2018</strong>
          </div>
          <div class="flex flex-wrap items-center gap-1.5">
            <span>Location:</span>
            <strong class="text-ink">Karur, Tamil Nadu</strong>
          </div>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink mb-3 sm:mb-4">
          Services
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm" role="list">
          <li>
            <a href="/services/whatsapp-ai-agent/" class="text-body hover:text-accent transition-colors min-h-[36px] inline-flex items-center">
              WhatsApp AI Agent
            </a>
          </li>
          <li>
            <a href="/services/website-ai-assistant/" class="text-body hover:text-accent transition-colors min-h-[36px] inline-flex items-center">
              Website AI Assistant
            </a>
          </li>
          <li>
            <a href="/services/workflow-automation/" class="text-body hover:text-accent transition-colors min-h-[36px] inline-flex items-center">
              Workflow Automation
            </a>
          </li>
          <li>
            <a href="/services/document-order-processing/" class="text-body hover:text-accent transition-colors min-h-[36px] inline-flex items-center">
              Document & Order Processing
            </a>
          </li>
          <li>
            <a href="/services/ai-audit-training/" class="text-body hover:text-accent transition-colors min-h-[36px] inline-flex items-center">
              AI Audit & Team Training
            </a>
          </li>
          <li>
            <a href="/services/website-design/" class="text-body hover:text-accent transition-colors min-h-[36px] inline-flex items-center">
              Website Design & Dev
            </a>
          </li>
          <li>
            <a href="/services/" class="text-accent font-medium hover:underline inline-flex items-center gap-1 pt-1 min-h-[36px]">
              View all services &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Navigation & Legal -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink mb-3 sm:mb-4">
          Company
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm" role="list">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class="text-body hover:text-accent transition-colors min-h-[36px] inline-flex items-center">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="pt-2 border-t border-border">
            <a href="/privacy/" class="text-body hover:text-accent transition-colors min-h-[36px] inline-flex items-center">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms/" class="text-body hover:text-accent transition-colors min-h-[36px] inline-flex items-center">
              Terms of Service
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Contact & Direct Channels -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-ink mb-3 sm:mb-4">
          Direct Contact
        </h3>
        <div class="text-xs sm:text-sm text-body space-y-2.5">
          <div>
            <span class="block text-xs font-semibold text-ink-muted">Office / Working Address:</span>
            <p class="mt-0.5 text-ink font-medium">
              Vengamedu, Karur, Tamil Nadu
            </p>
          </div>
          <div>
            <span class="block text-xs font-semibold text-ink-muted">Email:</span>
            <a href={`mailto:${siteConfig.email}`} class="text-accent hover:underline break-all inline-block mt-0.5 font-medium">
              {siteConfig.email}
            </a>
          </div>
          <div>
            <span class="block text-xs font-semibold text-ink-muted">WhatsApp / Phone:</span>
            <a href={siteConfig.whatsappHref} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-medium inline-block mt-0.5">
              +91 99445 26954
            </a>
          </div>
          <div>
            <span class="block text-xs font-semibold text-ink-muted">Response Commitment:</span>
            <span class="text-ink font-medium">Within 1 working day</span>
          </div>
          <div class="pt-2 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-ink-muted">
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-accent transition-colors inline-flex items-center gap-1"
            >
              <span>Instagram</span>
              <PlaceholderChip needed="Instagram URL">[[CONFIRM]]</PlaceholderChip>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom strip -->
    <div class="mt-10 sm:mt-12 pt-6 sm:pt-8 border-t border-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-ink-muted">
      <p>
        &copy; {currentYear} GM Design. All rights reserved. Designed with India's DPDP Act 2023 principles.
      </p>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>No cookies, no tracking pixels.</span>
        <span>&bull;</span>
        <a href="#main-header" class="hover:text-ink transition-colors font-medium">Back to top &uarr;</a>
      </div>
    </div>
  </div>
</footer>
