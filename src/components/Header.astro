---
import { navItems, serviceDropdown, siteConfig } from '../config/site';
import Button from './Button.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Determine active nav item
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};

const bookingHref = siteConfig.bookingUrl.startsWith('http')
  ? siteConfig.bookingUrl
  : siteConfig.defaultBookingHref;
---

<header
  class="sticky top-0 z-40 w-full bg-surface/95 backdrop-blur-sm border-b border-border transition-shadow duration-180"
  id="main-header"
>
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo -->
      <a
        href="/"
        class="group flex items-center gap-2 sm:gap-2.5 min-h-tap py-1.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent rounded-sm"
        aria-label="GM Design - Home"
      >
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded bg-ink flex items-center justify-center text-white font-bold text-sm sm:text-base tracking-tight group-hover:bg-accent transition-colors shrink-0">
          GM
        </div>
        <div class="flex flex-col">
          <span class="text-base sm:text-lg font-bold tracking-tight text-ink leading-tight">GM Design</span>
          <span class="text-[10px] sm:text-[11px] font-medium tracking-wide text-ink-muted uppercase leading-none">AI & Web Systems</span>
        </div>
      </a>

      <!-- Desktop Navigation (5 items + 1 button) -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-1.5" aria-label="Main navigation">
        {
          navItems.map((item) => {
            const active = isActive(item.href);

            if (item.label === 'Services') {
              return (
                <div class="relative group" id="desktop-services-menu">
                  <a
                    href="/services/"
                    class:list={[
                      'inline-flex items-center gap-1.5 px-3.5 py-2 text-sm font-medium rounded-md min-h-tap transition-colors',
                      active
                        ? 'text-accent font-semibold bg-accent-soft'
                        : 'text-ink hover:text-accent hover:bg-surface-soft',
                    ]}
                    aria-haspopup="true"
                    aria-expanded="false"
                    id="services-menu-button"
                  >
                    <span>Services</span>
                    <svg
                      class="w-4 h-4 text-ink-muted transition-transform duration-180 group-hover:rotate-180"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </a>

                  {/* Mega-Dropdown panel on desktop */}
                  <div
                    class="absolute left-1/2 -translate-x-1/2 top-full mt-1.5 w-[640px] bg-surface rounded-lg shadow-elevated border border-border p-5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-180 z-50 focus-within:opacity-100 focus-within:visible"
                    role="menu"
                    aria-labelledby="services-menu-button"
                  >
                    <div class="grid grid-cols-2 gap-6">
                      {/* Block A: AI Services (First, ~70% prominence) */}
                      <div class="space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-border">
                          <span class="text-xs font-bold uppercase tracking-wider text-accent">
                            AI Services (Core)
                          </span>
                          <span class="text-[11px] font-semibold text-blue-800 bg-blue-50 px-2 py-0.5 rounded">
                            Built for SMBs
                          </span>
                        </div>
                        <ul class="space-y-1.5">
                          {serviceDropdown[0].items.map((sub) => (
                            <li>
                              <a
                                href={sub.href}
                                class="block p-2 rounded-md hover:bg-accent-soft transition-colors group/item"
                              >
                                <div class="flex items-center gap-1.5">
                                  <span class="text-sm font-semibold text-ink group-hover/item:text-accent">
                                    {sub.label}
                                  </span>
                                  {sub.badge && (
                                    <span class="text-[10px] font-bold uppercase px-1.5 py-0.2 bg-blue-100 text-blue-900 rounded">
                                      {sub.badge}
                                    </span>
                                  )}
                                </div>
                                <p class="text-xs text-body leading-snug mt-0.5 line-clamp-1">
                                  {sub.description}
                                </p>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>

                      {/* Block B: Websites & Marketing */}
                      <div class="space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-border">
                          <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">
                            Websites & Marketing
                          </span>
                          <span class="text-[11px] text-ink-muted">Proven Work</span>
                        </div>
                        <ul class="space-y-1.5">
                          {serviceDropdown[1].items.map((sub) => (
                            <li>
                              <a
                                href={sub.href}
                                class="block p-2 rounded-md hover:bg-surface-soft transition-colors group/item"
                              >
                                <div class="text-sm font-semibold text-ink group-hover/item:text-accent">
                                  {sub.label}
                                </div>
                                <p class="text-xs text-body leading-snug mt-0.5 line-clamp-1">
                                  {sub.description}
                                </p>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-border flex items-center justify-between bg-surface-soft -mx-5 -mb-5 px-5 py-3 rounded-b-lg">
                      <span class="text-xs text-ink-muted">
                        Unsure which fits your business?
                      </span>
                      <a
                        href="/services/"
                        class="text-xs font-semibold text-accent hover:text-accent-hover inline-flex items-center gap-1"
                      >
                        Explore all services hub &rarr;
                      </a>
                    </div>
                  </div>
                </div>
              );
            }

            return (
              <a
                href={item.href}
                class:list={[
                  'px-3.5 py-2 text-sm font-medium rounded-md min-h-tap inline-flex items-center transition-colors',
                  active
                    ? 'text-accent font-semibold bg-accent-soft'
                    : 'text-ink hover:text-accent hover:bg-surface-soft',
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      <!-- Desktop CTA Button -->
      <div class="hidden md:flex items-center gap-3">
        <Button href={bookingHref} variant="primary" size="md">
          Book a free call
        </Button>
      </div>

      <!-- Mobile Top Bar Actions (Call button + Hamburger) -->
      <div class="flex md:hidden items-center gap-2">
        <Button
          href={bookingHref}
          variant="primary"
          size="sm"
          class="text-xs px-3 py-1.5 min-h-[38px] font-semibold"
        >
          Book call
        </Button>
        <button
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-md text-ink hover:bg-surface-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent min-h-tap min-w-tap"
          aria-controls="mobile-menu"
          aria-expanded="false"
          id="mobile-menu-toggle"
          aria-label="Toggle navigation menu"
        >
          <svg
            class="w-6 h-6 menu-icon-open"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg
            class="w-6 h-6 menu-icon-close hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer / Menu -->
  <!-- Hard rule: On mobile, Services opens the hub page (/services/), not a nested accordion -->
  <div
    class="md:hidden hidden border-b border-border bg-surface px-4 pt-3 pb-6 space-y-3 shadow-lg"
    id="mobile-menu"
  >
    <nav class="flex flex-col space-y-1" aria-label="Mobile navigation">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'flex items-center justify-between px-3.5 py-2.5 text-sm sm:text-base font-medium rounded-md min-h-tap transition-colors',
                active
                  ? 'text-accent font-semibold bg-accent-soft'
                  : 'text-ink hover:bg-surface-soft',
              ]}
            >
              <span>{item.label}</span>
              {item.label === 'Services' && (
                <span class="text-xs text-accent font-semibold">Services Hub &rarr;</span>
              )}
            </a>
          );
        })
      }
    </nav>

    <div class="pt-3 border-t border-border space-y-2">
      <Button href={bookingHref} variant="primary" size="md" class="w-full justify-center">
        Book a free 30-minute call
      </Button>
      <a
        href={siteConfig.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 w-full min-h-tap py-2.5 px-4 text-sm font-medium text-ink bg-surface-soft hover:bg-slate-200 rounded-md transition-colors"
      >
        <span>Prefer WhatsApp? Message us</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = toggleBtn?.querySelector('.menu-icon-open');
  const closeIcon = toggleBtn?.querySelector('.menu-icon-close');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      openIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    });
  }
</script>
