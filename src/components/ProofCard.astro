---
import PlaceholderChip from './PlaceholderChip.astro';

export type ProjectStatus = 'client' | 'pilot' | 'prototype' | 'demo' | 'archive';

interface Props {
  title: string;
  slug: string;
  category: string;
  status: ProjectStatus;
  year?: string;
  clientType: string;
  problem: string;
  solution: string;
  result: string;
  stack?: string[];
  image?: string;
  liveUrl?: string;
  class?: string;
}

const {
  title,
  slug,
  category,
  status,
  year,
  clientType,
  problem,
  solution,
  result,
  stack = [],
  image,
  liveUrl,
  class: className = '',
} = Astro.props;

const statusConfig: Record<
  ProjectStatus,
  { label: string; bg: string; text: string; border: string }
> = {
  client: {
    label: 'Client Project',
    bg: 'bg-emerald-50',
    text: 'text-emerald-800',
    border: 'border-emerald-200',
  },
  pilot: {
    label: 'Pilot',
    bg: 'bg-blue-50',
    text: 'text-blue-800',
    border: 'border-blue-200',
  },
  prototype: {
    label: 'In-house Prototype',
    bg: 'bg-amber-50',
    text: 'text-amber-800',
    border: 'border-amber-200',
  },
  demo: {
    label: 'Interactive Demo',
    bg: 'bg-purple-50',
    text: 'text-purple-800',
    border: 'border-purple-200',
  },
  archive: {
    label: 'Archive Work',
    bg: 'bg-slate-100',
    text: 'text-slate-700',
    border: 'border-slate-200',
  },
};

const badge = statusConfig[status] || statusConfig.prototype;
const href = `/portfolio/${slug}/`;
---

<article
  class:list={[
    'flex flex-col justify-between rounded-lg border border-border bg-surface overflow-hidden hover:border-slate-300 transition-all duration-180 hover:shadow-card',
    className,
  ]}
>
  <div class="p-4 sm:p-5 flex-1">
    <!-- Top Metadata -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
      <div class="flex flex-wrap items-center gap-1.5">
        <span
          class:list={[
            'inline-flex items-center px-2 py-0.5 rounded text-[10px] sm:text-[11px] font-semibold border shrink-0',
            badge.bg,
            badge.text,
            badge.border,
          ]}
        >
          {badge.label}
        </span>
        <span class="text-[11px] sm:text-xs text-ink-muted">
          {category}
        </span>
      </div>

      {year && (
        <span class="text-[11px] sm:text-xs font-mono text-ink-muted shrink-0">
          {year.includes('CONFIRM') ? (
            <PlaceholderChip needed="year completed">{year}</PlaceholderChip>
          ) : (
            year
          )}
        </span>
      )}
    </div>

    <!-- Title & Client Type -->
    <h3 class="text-base sm:text-lg font-bold text-ink leading-snug">
      <a
        href={href}
        class="hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent rounded-sm transition-colors"
      >
        {title}
      </a>
    </h3>
    <p class="text-[11px] sm:text-xs font-medium text-ink-muted mt-0.5">
      Client: {clientType}
    </p>

    <!-- Problem & Solution Block -->
    <div class="mt-3 space-y-2 text-xs">
      <div class="bg-surface-soft p-2.5 rounded border border-border/80">
        <span class="block text-[10px] font-bold uppercase tracking-wider text-ink-muted mb-0.5">
          The Problem
        </span>
        <p class="text-body leading-relaxed">
          {problem}
        </p>
      </div>

      <div class="p-1">
        <span class="block text-[10px] font-bold uppercase tracking-wider text-ink-muted mb-0.5">
          What was built
        </span>
        <p class="text-body leading-relaxed">
          {solution}
        </p>
      </div>

      <!-- Result (with check for confirm) -->
      <div class="pt-1.5 border-t border-border">
        <span class="block text-[10px] font-bold uppercase tracking-wider text-accent mb-0.5">
          Measured Outcome / Result
        </span>
        <div class="text-ink font-semibold">
          {result.includes('CONFIRM') ? (
            <PlaceholderChip needed="verified project result / metric">
              {result}
            </PlaceholderChip>
          ) : (
            result
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Actions -->
  <div class="px-4 sm:px-5 py-2.5 bg-surface-soft border-t border-border flex flex-wrap items-center justify-between gap-2 text-xs">
    <div class="flex items-center gap-1 flex-wrap">
      {stack.slice(0, 3).map((tool) => (
        <span class="px-1.5 py-0.5 bg-surface rounded border border-border text-ink-muted font-mono text-[10px]">
          {tool}
        </span>
      ))}
    </div>
    <a
      href={href}
      class="font-semibold text-accent hover:text-accent-hover min-h-tap inline-flex items-center gap-1 py-1 ml-auto text-xs"
    >
      <span>Read study</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>
