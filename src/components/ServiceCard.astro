---
import PlaceholderChip from './PlaceholderChip.astro';

interface Props {
  title: string;
  outcome: string;
  priceFrom: string;
  suggestedPrice?: string;
  href: string;
  bullets?: string[];
  badge?: string;
  isAi?: boolean;
  class?: string;
}

const {
  title,
  outcome,
  priceFrom,
  suggestedPrice,
  href,
  bullets = [],
  badge,
  isAi = true,
  class: className = '',
} = Astro.props;
---

<article
  class:list={[
    'group flex flex-col justify-between p-4 sm:p-5 lg:p-6 rounded-lg border border-border bg-surface hover:border-slate-300 transition-all duration-180 hover:shadow-card',
    className,
  ]}
>
  <div>
    <!-- Badge / Header with clean flex-wrap for mobile -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
      {badge ? (
        <span class="inline-flex items-center text-[10px] sm:text-xs font-semibold text-accent bg-accent-soft px-2 py-0.5 rounded border border-blue-100 shrink-0">
          {badge}
        </span>
      ) : (
        <span class="text-[11px] sm:text-xs font-medium text-ink-muted shrink-0">
          {isAi ? 'AI Service' : 'Web & Marketing'}
        </span>
      )}

      <!-- Price indicator -->
      <div class="text-[11px] sm:text-xs text-ink-muted">
        <span>From </span>
        <span class="font-bold text-ink">
          {priceFrom.includes('CONFIRM') ? (
            <PlaceholderChip needed={`price for ${title}`}>
              {suggestedPrice || priceFrom}
            </PlaceholderChip>
          ) : (
            priceFrom
          )}
        </span>
      </div>
    </div>

    <!-- Title & Outcome -->
    <h3 class="text-base sm:text-lg font-bold text-ink group-hover:text-accent transition-colors leading-snug">
      <a href={href} class="focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent rounded-sm">
        {title}
      </a>
    </h3>

    <p class="mt-1.5 text-xs sm:text-sm text-body/90 leading-relaxed">
      {outcome}
    </p>

    <!-- Deliverables / Bullets -->
    {bullets.length > 0 && (
      <ul class="mt-3 sm:mt-4 space-y-1.5 text-xs sm:text-sm text-body" role="list">
        {bullets.map((b) => (
          <li class="flex items-start gap-2">
            <svg
              class="w-3.5 h-3.5 text-accent shrink-0 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
            </svg>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- Footer Link -->
  <div class="mt-5 pt-3.5 border-t border-border flex items-center justify-between text-xs">
    <span class="text-ink-muted hidden xs:inline">Fixed price in writing</span>
    <a
      href={href}
      class="inline-flex items-center gap-1 font-semibold text-accent hover:text-accent-hover transition-colors min-h-tap py-2 ml-auto"
      aria-label={`Learn more about ${title}`}
    >
      <span>Learn more</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>
