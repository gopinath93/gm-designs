---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section
  class:list={[
    'border-y border-border bg-surface-soft/80 py-3.5 sm:py-4 px-4 sm:px-6',
    className,
  ]}
  aria-label="Key business facts"
>
  <div class="max-w-content mx-auto">
    <!-- Desktop / Tablet: One clean continuous line (Section 7, Section 3) -->
    <div class="hidden sm:flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-xs sm:text-sm font-medium text-body text-center">
      <span class="inline-flex items-center gap-1 text-ink font-semibold">
        Karur-based
      </span>
      <span class="text-slate-300" aria-hidden="true">&bull;</span>
      
      <span class="inline-flex items-center gap-1">
        Working since <strong class="text-ink">2018</strong>
      </span>
      <span class="text-slate-300" aria-hidden="true">&bull;</span>

      <span class="inline-flex items-center gap-1">
        <strong class="text-ink">85</strong> websites delivered
      </span>
      <span class="text-slate-300" aria-hidden="true">&bull;</span>

      <span class="text-ink font-semibold">Reply within 1 working day</span>
      <span class="text-slate-300" aria-hidden="true">&bull;</span>

      <span class="text-ink font-semibold">Fixed-price proposals in writing</span>
    </div>

    <!-- Mobile (<640px): Clean, balanced 2-column fact cards (No messy wrap) -->
    <div class="sm:hidden grid grid-cols-2 gap-2 text-[11px] text-center font-medium">
      <div class="p-2 bg-surface rounded border border-border/80 flex items-center justify-center gap-1 shadow-xs font-semibold text-ink">
        <span class="text-ink-muted">Location:</span>
        <span>Karur</span>
      </div>
      <div class="p-2 bg-surface rounded border border-border/80 flex items-center justify-center gap-1 shadow-xs">
        <span class="text-ink-muted">Since:</span>
        <span class="font-semibold text-ink">2018</span>
      </div>
      <div class="p-2 bg-surface rounded border border-border/80 flex items-center justify-center gap-1 shadow-xs">
        <span class="font-semibold text-ink">85</span>
        <span class="text-ink-muted">sites built</span>
      </div>
      <div class="p-2 bg-surface rounded border border-border/80 flex items-center justify-center gap-1 text-ink font-semibold shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Reply in 1 day</span>
      </div>
      <div class="col-span-2 p-2 bg-surface rounded border border-border/80 text-ink font-semibold text-xs shadow-xs">
        Fixed-price proposals in writing
      </div>
    </div>
  </div>
</section>
