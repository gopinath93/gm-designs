---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactForm from '../components/ContactForm.astro';
import Button from '../components/Button.astro';
import PlaceholderChip from '../components/PlaceholderChip.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { siteConfig } from '../config/site';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${siteConfig.name}`,
  description: 'Tell us what slows your team down. Book a call or send a quick WhatsApp enquiry.',
  url: `${siteConfig.url}/contact/`,
};

const bookingHref = siteConfig.bookingUrl.startsWith('http')
  ? siteConfig.bookingUrl
  : siteConfig.defaultBookingHref;
---

<BaseLayout
  title={`Contact ${siteConfig.name} — Book a Free Call or WhatsApp Us`}
  description="Tell us what slows your team down. Reach GM Design for WhatsApp AI agents, workflow automations, and web systems. Reply in 1 working day."
  jsonLd={contactSchema}
>
  <!-- Page Header -->
  <section class="pt-8 pb-10 sm:pt-14 sm:pb-14 bg-surface border-b border-border">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-ink-muted mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-accent transition-colors">Home</a>
        <span aria-hidden="true">&bull;</span>
        <span class="text-ink font-semibold" aria-current="page">Contact</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-md text-[10px] sm:text-xs font-semibold bg-accent-soft text-accent border border-blue-100">
          <span>Reply in 1 Working Day &bull; No Sales Pressure</span>
        </div>

        <!-- Section 10 H1 Requirement -->
        <h1 class="text-xl sm:text-3xl lg:text-[34px] font-bold tracking-tight text-ink leading-snug">
          Tell us what slows your team down
        </h1>

        <p class="text-xs sm:text-sm text-body leading-relaxed max-w-prose">
          Whether you want a 24/7 WhatsApp AI assistant, an automated invoicing workflow, or a clean website, we will listen and give you an honest recommendation.
        </p>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <TrustStrip />

  <!-- Main Contact Grid (Form + What Happens Next + Direct Options) -->
  <section class="py-10 sm:py-18 bg-surface-soft border-b border-border">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Left: Full 6-Field Contact Form -->
        <div class="lg:col-span-7 bg-surface p-5 sm:p-8 rounded-xl border border-border shadow-card space-y-4">
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-ink">
              Send an enquiry
            </h2>
            <p class="text-xs sm:text-sm text-ink-muted mt-0.5">
              Strictly confidential. No spam or automated broadcasts.
            </p>
          </div>

          <ContactForm compact={false} />
        </div>

        <!-- Right: What Happens Next & Direct Channels -->
        <div class="lg:col-span-5 space-y-6">
          <!-- What Happens Next Box -->
          <div class="p-5 sm:p-7 rounded-xl border border-border bg-surface space-y-4 shadow-xs">
            <div class="flex items-center gap-2 pb-2 border-b border-border">
              <span class="w-2.5 h-2.5 rounded-full bg-accent"></span>
              <h2 class="text-base font-bold text-ink">
                What happens next
              </h2>
            </div>

            <ol class="space-y-3.5 text-xs sm:text-sm text-body">
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-accent-soft text-accent font-bold font-mono text-xs flex items-center justify-center shrink-0 mt-0.5">
                  1
                </span>
                <div>
                  <strong class="text-ink block">Personal reply:</strong>
                  <span>We confirm receipt on WhatsApp or email within <PlaceholderChip needed="response time commitment">[[CONFIRM: time]]</PlaceholderChip> (usually within 1 working day).</span>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-accent-soft text-accent font-bold font-mono text-xs flex items-center justify-center shrink-0 mt-0.5">
                  2
                </span>
                <div>
                  <strong class="text-ink block">Free 30-minute call:</strong>
                  <span>We schedule a short listening call to examine your daily bottleneck. No generic sales slides.</span>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-accent-soft text-accent font-bold font-mono text-xs flex items-center justify-center shrink-0 mt-0.5">
                  3
                </span>
                <div>
                  <strong class="text-ink block">Written proposal:</strong>
                  <span>In 2 working days, you receive a written fixed-price proposal detailing exact deliverables, milestone costs, and client inputs.</span>
                </div>
              </li>
            </ol>
          </div>

          <!-- Direct Channels Box -->
          <div class="p-5 sm:p-7 rounded-xl border border-border bg-surface space-y-4 shadow-xs">
            <h3 class="text-xs font-bold uppercase tracking-wider text-ink-muted">
              Prefer direct contact?
            </h3>

            <div class="space-y-3">
              <!-- Cal.com Booking Link -->
              <a
                href={bookingHref}
                class="flex items-center justify-between p-3 rounded-lg border border-blue-200 bg-accent-soft hover:bg-blue-100 transition-colors group"
                id="book"
              >
                <div class="flex items-center gap-3">
                  <span class="text-lg">📅</span>
                  <div>
                    <span class="text-xs font-bold text-ink group-hover:text-accent block">
                      Book a free 30-minute call
                    </span>
                    <span class="text-[11px] text-ink-muted">Pick a time directly on Cal.com</span>
                  </div>
                </div>
                <span class="text-xs font-bold text-accent">&rarr;</span>
              </a>

              <!-- WhatsApp Direct -->
              <a
                href={siteConfig.whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-3 rounded-lg border border-border bg-surface-soft hover:bg-slate-200 transition-colors group"
              >
                <div class="flex items-center gap-3">
                  <span class="text-lg">💬</span>
                  <div>
                    <span class="text-xs font-bold text-ink group-hover:text-accent block">
                      Message on WhatsApp
                    </span>
                    <span class="text-[11px] text-ink-muted">Quick answers & pricing queries</span>
                  </div>
                </div>
                <span class="text-xs font-bold text-accent">&rarr;</span>
              </a>

              <!-- Direct Email -->
              <a
                href={`mailto:${siteConfig.email}`}
                class="flex items-center justify-between p-3 rounded-lg border border-border bg-surface-soft hover:bg-slate-200 transition-colors group"
              >
                <div class="flex items-center gap-3">
                  <span class="text-lg">✉️</span>
                  <div>
                    <span class="text-xs font-bold text-ink group-hover:text-accent block">
                      {siteConfig.email}
                    </span>
                    <span class="text-[11px] text-ink-muted">Send documents and sample files</span>
                  </div>
                </div>
                <span class="text-xs font-bold text-accent">&rarr;</span>
              </a>
            </div>
          </div>

          <!-- Working Address & Hours Box -->
          <div class="p-5 sm:p-7 rounded-xl border border-border bg-surface space-y-3 shadow-xs text-xs sm:text-sm text-body">
            <h3 class="text-xs font-bold uppercase tracking-wider text-ink-muted">
              Working Location & Hours
            </h3>

            <div>
              <span class="font-semibold text-ink block">Physical Office / Working Address:</span>
              <p class="mt-1 text-xs text-body leading-relaxed font-medium">
                Vengamedu, Karur, Tamil Nadu
              </p>
              <div class="mt-2">
                <a
                  href="https://www.google.com/maps/search/?api=1&query=Vengamedu,+Karur,+Tamil+Nadu"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold text-accent hover:underline inline-flex items-center gap-1"
                >
                  <span>Open location on Google Maps</span>
                  <span aria-hidden="true">&nearr;</span>
                </a>
              </div>
            </div>

            <div class="pt-2 border-t border-border space-y-1">
              <span class="font-semibold text-ink block text-xs">Working Hours:</span>
              <p class="text-xs text-ink-muted">
                Monday to Friday: 9:30 AM – 6:30 PM IST<br />
                Saturday: Emergency deployments & scheduled client tests only
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
