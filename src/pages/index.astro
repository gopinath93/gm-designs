---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import TrustStrip from '../components/TrustStrip.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProofCard from '../components/ProofCard.astro';
import Steps from '../components/Steps.astro';
import FAQ, { type FaqItem } from '../components/FAQ.astro';
import CtaBand from '../components/CtaBand.astro';
import PlaceholderChip from '../components/PlaceholderChip.astro';
import WhatsAppDemoChat from '../components/WhatsAppDemoChat.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { siteConfig } from '../config/site';

// 6 Core FAQs from Section 7
const homeFaqs: FaqItem[] = [
  {
    question: 'How much does it cost?',
    answer:
      'We quote upfront fixed prices. A WhatsApp AI agent starts from <span class="font-semibold text-ink">₹25,000 setup + ₹4,000/month</span> for updates and monitoring. Workflow automations start from <span class="font-semibold text-ink">₹15,000</span>. A 1-week AI Audit is <span class="font-semibold text-ink">₹7,500 to ₹15,000 fixed</span>. Third-party usage (Meta fees and AI tokens) is billed directly at actual cost.',
  },
  {
    question: 'How long does it take?',
    answer:
      'A standard WhatsApp assistant or lead automation takes <strong>1 to 2 weeks</strong> from kickoff to live testing. A 1-week AI Audit is delivered in <strong>5 working days</strong>. Custom pipelines take 3 to 4 weeks.',
  },
  {
    question: 'Will it speak Tamil?',
    answer:
      'Yes. Our WhatsApp assistants support both conversational English and Tamil—in Tamil script (தமிழ்) or everyday Tanglish. Local retail and wholesale buyers feel completely understood.',
  },
  {
    question: 'What if the AI gives a wrong answer?',
    answer:
      'The assistant only answers from your verified price lists and catalogs. It never guesses. If a query is unclear, it alerts your human staff immediately for personal handover.',
  },
  {
    question: 'Who owns my data and the system?',
    answer:
      '<strong>You own 100% of your data, accounts, and prompts.</strong> Everything is hosted in your company WhatsApp Business or Cloudflare accounts. Zero proprietary lock-in.',
  },
  {
    question: 'Do I need technical staff to run this?',
    answer:
      'No. The system connects to everyday tools: WhatsApp, Google Sheets, and email. We train your office team in under 30 minutes with a simple 1-page guide.',
  },
];
---

<BaseLayout
  title="GM Design — AI Assistants & Workflow Automation for Indian Businesses"
  description="We set up WhatsApp AI agents and automations that save your team hours every day. In Tamil and English. Fixed price. Human handover when unsure."
>
  <!-- ========================================== -->
  <!-- 2. HERO SECTION (Above the fold, 360px & Desktop) -->
  <!-- ========================================== -->
  <section class="relative pt-6 pb-8 sm:pt-12 sm:pb-14 lg:pt-16 lg:pb-18 bg-surface border-b border-border overflow-hidden">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
        <!-- Left: Headline & CTA -->
        <div class="lg:col-span-7 space-y-3.5 sm:space-y-4 text-left">
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-md text-[10px] sm:text-xs font-semibold bg-accent-soft text-accent border border-blue-100">
            <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
            <span>AI as a Service &bull; Indian SMBs</span>
          </div>

          <h1 class="text-xl sm:text-3xl lg:text-[34px] font-bold tracking-tight text-ink leading-snug">
            Practical AI assistants &amp; workflow automations for Indian businesses.
          </h1>

          <p class="text-xs sm:text-base text-body leading-relaxed max-w-xl">
            We build custom WhatsApp agents and automations that answer customer inquiries, book orders, and eliminate manual data entry. Bilingual (Tamil &amp; English) with strict human handover.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 pt-1">
            <Button href={siteConfig.bookingUrl} target="_blank" rel="noopener noreferrer" variant="primary" size="md" class="text-center justify-center font-semibold text-xs sm:text-sm py-2.5 sm:py-3">
              Book a free 30-minute call
            </Button>
            <Button href="/portfolio/" variant="outline" size="md" class="text-center justify-center text-xs sm:text-sm py-2.5 sm:py-3">
              See our work
            </Button>
          </div>

          <!-- Secondary WhatsApp prompt -->
          <div class="text-[11px] sm:text-xs text-ink-muted pt-0.5 flex flex-wrap items-center gap-1.5">
            <span>Prefer WhatsApp? Message us at</span>
            <a href={siteConfig.whatsappHref} target="_blank" rel="noopener noreferrer" class="font-semibold text-accent hover:underline">
              +91 99445 26954
            </a>
          </div>

          <!-- Fast trust signals below CTA -->
          <div class="pt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] sm:text-xs text-ink-muted">
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-accent shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
              </svg>
              No lock-in
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-accent shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
              </svg>
              Written milestone pricing
            </span>
            <span class="inline-flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-accent shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
              </svg>
              You own your data
            </span>
          </div>
        </div>

        <!-- Right: Real WhatsApp AI Agent Conversation Simulation -->
        <div class="lg:col-span-5 flex justify-center pt-2 lg:pt-0">
          <WhatsAppDemoChat />
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- 3. TRUST STRIP (One line, facts only) -->
  <!-- ========================================== -->
  <TrustStrip />

  <!-- ========================================== -->
  <!-- 4. "SOUND FAMILIAR?" (3 Short Pain Points) -->
  <!-- ========================================== -->
  <section class="py-8 sm:py-14 bg-surface-soft border-b border-border" aria-labelledby="pain-points-heading">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Sound Familiar?"
        title="Three bottlenecks costing Indian businesses time and lost sales"
        description="Most business owners don't need complicated software. They need these three daily time-drains fixed."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 sm:gap-5">
        <!-- Pain Point 1 -->
        <a
          href="/services/whatsapp-ai-agent/"
          class="group p-4 sm:p-5 rounded-lg border border-border bg-surface hover:border-accent transition-all duration-180 hover:shadow-card flex flex-col justify-between"
        >
          <div>
            <div class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-200 mb-2.5">
              Night Inquiries
            </div>
            <h3 class="text-sm sm:text-base font-bold text-ink group-hover:text-accent transition-colors leading-snug">
              Unanswered After-Hours Leads
            </h3>
            <p class="mt-1.5 text-xs sm:text-sm text-body leading-relaxed">
              Customers message after 8 PM. Without quick pricing or catalog replies, they move to a competitor by morning.
            </p>
          </div>
          <div class="mt-3.5 pt-2.5 border-t border-border flex items-center justify-between text-xs font-semibold text-accent">
            <span>The fix: 24/7 WhatsApp AI</span>
            <span aria-hidden="true">&rarr;</span>
          </div>
        </a>

        <!-- Pain Point 2 -->
        <a
          href="/services/document-order-processing/"
          class="group p-4 sm:p-5 rounded-lg border border-border bg-surface hover:border-accent transition-all duration-180 hover:shadow-card flex flex-col justify-between"
        >
          <div>
            <div class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-800 border border-rose-200 mb-2.5">
              Manual Entry
            </div>
            <h3 class="text-sm sm:text-base font-bold text-ink group-hover:text-accent transition-colors leading-snug">
              Manual Order Typing
            </h3>
            <p class="mt-1.5 text-xs sm:text-sm text-body leading-relaxed">
              Staff spend 2+ hours daily copying purchase orders and invoices into Excel or Tally. Typos lead to delivery delays.
            </p>
          </div>
          <div class="mt-3.5 pt-2.5 border-t border-border flex items-center justify-between text-xs font-semibold text-accent">
            <span>The fix: Automated PDF Extraction</span>
            <span aria-hidden="true">&rarr;</span>
          </div>
        </a>

        <!-- Pain Point 3 -->
        <a
          href="/services/workflow-automation/"
          class="group p-4 sm:p-5 rounded-lg border border-border bg-surface hover:border-accent transition-all duration-180 hover:shadow-card flex flex-col justify-between"
        >
          <div>
            <div class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-800 border border-blue-200 mb-2.5">
              Follow-ups
            </div>
            <h3 class="text-sm sm:text-base font-bold text-ink group-hover:text-accent transition-colors leading-snug">
              Lost Follow-up Calls
            </h3>
            <p class="mt-1.5 text-xs sm:text-sm text-body leading-relaxed">
              Enquiries arrive on WhatsApp, but callbacks get forgotten during busy days at the shop or factory.
            </p>
          </div>
          <div class="mt-3.5 pt-2.5 border-t border-border flex items-center justify-between text-xs font-semibold text-accent">
            <span>The fix: Workflow Follow-up Reminders</span>
            <span aria-hidden="true">&rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- 5. WHAT WE DO (4 Cards) -->
  <!-- ========================================== -->
  <section class="py-8 sm:py-16 bg-surface border-b border-border" aria-labelledby="services-overview-heading">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="What We Do"
        title="Practical systems that save your team hours every week"
        description="Clear outcomes, transparent starting pricing, and zero tech jargon. You pay for working results."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        <!-- Card 1 -->
        <ServiceCard
          title="WhatsApp & Website AI Agents"
          outcome="An assistant trained on your exact prices, products, and FAQs that replies in seconds in Tamil and English, and hands over to your team when unsure."
          priceFrom="[[CONFIRM]]"
          suggestedPrice="from ₹25,000 setup + ₹4,000/mo"
          href="/services/whatsapp-ai-agent/"
          badge="Flagship Offer"
          isAi={true}
          bullets={[
            'Responds 24/7 to pricing and product inquiries',
            'Takes orders and logs details in Google Sheets',
            'Alerts your staff immediately when a human is needed',
          ]}
        />

        <!-- Card 2 -->
        <ServiceCard
          title="Workflow & Document Automation"
          outcome="Connect WhatsApp, PDFs, emails, Google Sheets, Tally, and your CRM so nobody wastes hours re-typing numbers."
          priceFrom="[[CONFIRM]]"
          suggestedPrice="from ₹15,000 per workflow"
          href="/services/workflow-automation/"
          isAi={true}
          bullets={[
            'Reads supplier invoices & customer POs into Excel automatically',
            'Automated payment reminders and shipping status updates',
            'Auto-syncs website and WhatsApp leads into your CRM',
          ]}
        />

        <!-- Card 3 -->
        <ServiceCard
          title="Custom AI Tools & AI Audit"
          outcome="A 1-week review to identify where AI saves time in your business, plus custom internal search assistants over company documents."
          priceFrom="[[CONFIRM]]"
          suggestedPrice="from ₹7,500 - ₹15,000 fixed"
          href="/services/ai-audit-training/"
          badge="Low-Risk Entry"
          isAi={true}
          bullets={[
            '1-Week AI Audit: ranked opportunities with exact cost & ROI',
            'Internal search assistant over standard operating procedures',
            'Hands-on team training session included',
          ]}
        />

        <!-- Card 4 -->
        <ServiceCard
          title="Websites & Digital Marketing"
          outcome="Fast, clear websites and local Google Maps rankings that turn visitors into phone calls and WhatsApp messages."
          priceFrom="[[CONFIRM]]"
          suggestedPrice="starting proposal in writing"
          href="/services/website-design/"
          badge="Core work since 2018"
          isAi={false}
          bullets={[
            'Mobile-first business sites (under 1.5s load time)',
            'Google Business Profile & local Maps SEO',
            'Targeted Meta & Google ads with transparent ROAS',
          ]}
        />
      </div>

      <div class="mt-6 text-center">
        <a
          href="/services/"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-accent hover:text-accent-hover min-h-tap py-2"
        >
          <span>View all 11 services and scope details</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- 6. PROOF: FEATURED WORK (3 Cards, Real Only) -->
  <!-- ========================================== -->
  <section class="py-8 sm:py-16 bg-surface-soft border-b border-border" aria-labelledby="featured-work-heading">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Proof & Case Studies"
        title="Real work, clearly labelled"
        description="We distinguish clearly between in-house prototypes, pilots, and delivered client projects."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        <!-- Card 1: PO Sentry (Prototype) -->
        <ProofCard
          title="WhatsApp Buyer-Query Agent ('PO Sentry')"
          slug="po-sentry"
          category="AI Services"
          status="prototype"
          year="2024"
          clientType="Home-textile export cluster"
          problem="International buyers message across multiple time zones asking for order statuses. Staff spent 3+ hours daily re-checking spreadsheets."
          solution="Custom WhatsApp agent linked to order database. Returns dispatch status and spec PDFs in 5 seconds."
          result="[[CONFIRM: verified metric / hours saved]]"
          stack={['WhatsApp Cloud API', 'Python', 'FastAPI', 'Google Sheets']}
        />

        <!-- Card 2: Multi-Agent Content Pipeline (Prototype) -->
        <ProofCard
          title="Multi-Agent Content & Fact Pipeline"
          slug="multi-agent-content"
          category="AI Services"
          status="prototype"
          year="2024"
          clientType="In-house publishing & documentation"
          problem="Writing technical documentation with verified facts required 4 to 5 manual review rounds."
          solution="A deterministic three-agent loop (writer, critic, scorer) verifying claims against source documents."
          result="[[CONFIRM: e.g. posts per week, time saved]]"
          stack={['Python', 'FastAPI', 'Claude / Gemini API']}
        />

        <!-- Card 3: PLSH Salon (Client Project) -->
        <ProofCard
          title="PLSH Salon & Spa Brand Package"
          slug="plsh-salon"
          category="Branding & Design"
          status="client"
          year="2020"
          clientType="Premium beauty salon in Chennai"
          problem="A new salon needed brand identity, price menus, signage, and social media launch campaign."
          solution="Designed complete visual identity, print-ready menus, store signage, and social creative package."
          result="Successful launch with 100+ appointments booked during opening week"
          stack={['Brand Identity', 'Graphic Design', 'Social Media']}
        />
      </div>

      <div class="mt-6 text-center">
        <a
          href="/portfolio/"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-accent hover:text-accent-hover min-h-tap py-2"
        >
          <span>See all past client projects and prototypes</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- 7. HOW IT WORKS (4 Steps) -->
  <!-- ========================================== -->
  <section class="py-8 sm:py-16 bg-surface border-b border-border" aria-labelledby="process-heading">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Our Process"
        title="How we work together (no surprises)"
        description="You always know what is being built, what it costs, and when you can test it on your own data."
      />

      <Steps
        clientRequirement="[[CONFIRM: e.g. FAQs, price list, a sample of past enquiries]]"
      />
    </div>
  </section>

  <!-- ========================================== -->
  <!-- 8. OUR PROMISES (Plain, Checkable) -->
  <!-- ========================================== -->
  <section class="py-8 sm:py-16 bg-surface-soft border-b border-border" aria-labelledby="promises-heading">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Our Commitments"
        title="Five plain promises in writing"
        description="We stand by every project we build. Here is what you can always hold us to."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-5">
        <!-- Promise 1 -->
        <div class="p-4 sm:p-5 rounded-lg border border-border bg-surface space-y-1.5">
          <div class="w-6 h-6 rounded-full bg-blue-50 text-accent flex items-center justify-center font-bold text-xs">
            ✓
          </div>
          <h3 class="text-sm sm:text-base font-bold text-ink">Fixed price, written upfront</h3>
          <p class="text-xs sm:text-sm text-body leading-relaxed">
            Written proposal with milestone scope and exact cost before we write any code. No hourly surprises.
          </p>
        </div>

        <!-- Promise 2 -->
        <div class="p-4 sm:p-5 rounded-lg border border-border bg-surface space-y-1.5">
          <div class="w-6 h-6 rounded-full bg-blue-50 text-accent flex items-center justify-center font-bold text-xs">
            ✓
          </div>
          <h3 class="text-sm sm:text-base font-bold text-ink">Pay in milestones</h3>
          <p class="text-xs sm:text-sm text-body leading-relaxed">
            Pay a deposit to start, and the balance only after testing the working system on your real data.
          </p>
        </div>

        <!-- Promise 3 -->
        <div class="p-4 sm:p-5 rounded-lg border border-border bg-surface space-y-1.5">
          <div class="w-6 h-6 rounded-full bg-blue-50 text-accent flex items-center justify-center font-bold text-xs">
            ✓
          </div>
          <h3 class="text-sm sm:text-base font-bold text-ink">You own your data &amp; system</h3>
          <p class="text-xs sm:text-sm text-body leading-relaxed">
            All code, WhatsApp accounts, and database sheets belong to you. Zero proprietary lock-in.
          </p>
        </div>

        <!-- Promise 4 -->
        <div class="p-4 sm:p-5 rounded-lg border border-border bg-surface space-y-1.5">
          <div class="w-6 h-6 rounded-full bg-blue-50 text-accent flex items-center justify-center font-bold text-xs">
            ✓
          </div>
          <h3 class="text-sm sm:text-base font-bold text-ink">Strict human handover</h3>
          <p class="text-xs sm:text-sm text-body leading-relaxed">
            The AI agent never invents answers. When an inquiry is unclear, it alerts your staff instantly.
          </p>
        </div>

        <!-- Promise 5 -->
        <div class="p-4 sm:p-5 rounded-lg border border-border bg-surface space-y-1.5 sm:col-span-2 lg:col-span-2">
          <div class="w-6 h-6 rounded-full bg-blue-50 text-accent flex items-center justify-center font-bold text-xs">
            ✓
          </div>
          <h3 class="text-sm sm:text-base font-bold text-ink">Honest advice: We say no to AI when it doesn't fit</h3>
          <p class="text-xs sm:text-sm text-body leading-relaxed">
            If a simple spreadsheet or basic auto-responder solves your issue, we will tell you directly on day one.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- 9. SAFETY & DATA (Short Block) -->
  <!-- ========================================== -->
  <section class="py-8 sm:py-14 bg-surface border-b border-border" aria-labelledby="safety-heading">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-xl border border-border bg-surface-soft p-5 sm:p-7">
        <div class="max-w-3xl space-y-3">
          <div class="inline-flex items-center gap-1.5 text-[10px] sm:text-xs font-bold uppercase tracking-wider text-accent bg-accent-soft border border-blue-100 px-2.5 py-0.5 rounded">
            <span>Data Protection &amp; Privacy</span>
          </div>

          <h2 id="safety-heading" class="text-lg sm:text-xl lg:text-2xl font-bold tracking-tight text-ink">
            Where your business data lives and how we protect it
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
            <div class="p-3 bg-surface rounded-md border border-border">
              <span class="block text-xs font-bold text-ink mb-1">Your Own Accounts</span>
              <p class="text-[11px] sm:text-xs text-body leading-relaxed">
                WhatsApp API and data storage live in your accounts. We never hold your logs hostage.
              </p>
            </div>

            <div class="p-3 bg-surface rounded-md border border-border">
              <span class="block text-xs font-bold text-ink mb-1">Zero Public Model Training</span>
              <p class="text-[11px] sm:text-xs text-body leading-relaxed">
                Enterprise APIs ensure your proprietary pricing and documents are never used to train public models.
              </p>
            </div>

            <div class="p-3 bg-surface rounded-md border border-border">
              <span class="block text-xs font-bold text-ink mb-1">Designed for DPDP 2023</span>
              <p class="text-[11px] sm:text-xs text-body leading-relaxed">
                Built adhering to India's Digital Personal Data Protection Act: purposeful consent and easy log deletion.
              </p>
            </div>
          </div>

          <p class="text-xs text-ink-muted pt-1">
            Read our <a href="/privacy/" class="text-accent underline font-medium">Privacy Policy</a> and <a href="/terms/" class="text-accent underline font-medium">Terms of Service</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- 10. TESTIMONIALS (Real People Only - Rule 2) -->
  <!-- ========================================== -->
  <section class="py-8 sm:py-16 bg-surface-soft border-b border-border" aria-labelledby="testimonials-heading">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Client Testimonials"
        title="What clients say about working with GM Design"
        description="Real people only. We never write, paraphrase, or invent testimonials."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl mx-auto">
        <!-- Testimonial 1 -->
        <TestimonialCard
          quote="GM Design helped us launch our brand from scratch with clear timelines and reliable creative execution. We got our entire opening collateral delivered on schedule."
          authorName="[[CONFIRM: verified client name]]"
          authorRole="Founder"
          companyName="PLSH Salon & Spa"
          companyUrl="https://plshsalon.in"
          isVerified={false}
        />

        <!-- Testimonial 2 (Placeholder awaiting owner confirmation) -->
        <div class="flex flex-col justify-between p-4 sm:p-6 rounded-lg border border-dashed border-border bg-surface">
          <div class="space-y-2">
            <span class="text-[10px] font-mono uppercase tracking-wider text-amber-900 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 inline-block font-semibold">
              Pending Owner Permission
            </span>
            <p class="text-xs sm:text-sm text-body italic leading-relaxed">
              "[[CONFIRM: Second verified client testimonial with full name, company link, and explicit permission]]"
            </p>
          </div>
          <div class="mt-3 pt-2.5 border-t border-border text-[11px] text-ink-muted">
            If fewer than 2 verified testimonials exist, this slot will remain hidden in production.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- 11. FAQ (6 Questions, Native <details>) -->
  <!-- ========================================== -->
  <section class="py-8 sm:py-16 bg-surface border-b border-border" aria-labelledby="faq-heading">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        align="center"
        eyebrow="Got Questions?"
        title="Frequently Asked Questions"
        description="Direct answers about pricing, language support, safety, and timelines."
      />

      <FAQ items={homeFaqs} />
    </div>
  </section>

  <!-- ========================================== -->
  <!-- 12. FINAL CTA BAND (Reassurance + 3-Field Form) -->
  <!-- ========================================== -->
  <section class="py-8 sm:py-16 bg-surface-soft" aria-label="Book a call or send enquiry">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <CtaBand
        headline="Not sure if AI fits your business? Tell us what slows your team down."
        subheadline="We will review your workflow and tell you honestly if an AI agent is right, or if a simple spreadsheet already solves it."
        showForm={true}
      />
    </div>
  </section>
</BaseLayout>
</BaseLayout>
