---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProofCard from '../../components/ProofCard.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import { portfolioItems, type ProjectCategory } from '../../data/portfolio';

// Check category from query param for SSR fallback
const requestedCategory = Astro.url.searchParams.get('category') as ProjectCategory | null;

const categories = ['All', 'AI', 'Websites', 'Marketing', 'Branding & Design'] as const;

// Ensure AI work appears first per Section 9
const sortedItems = [...portfolioItems].sort((a, b) => {
  if (a.category === 'AI' && b.category !== 'AI') return -1;
  if (a.category !== 'AI' && b.category === 'AI') return 1;
  return 0;
});
---

<BaseLayout
  title="Our Work & Case Studies — GM Design"
  description="Explore real client projects, in-house prototypes, and digital systems built for Indian businesses. AI workflows, websites, and brand identities."
>
  <!-- Page Header -->
  <section class="pt-8 pb-10 sm:pt-14 sm:pb-14 bg-surface border-b border-border">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-ink-muted mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-accent transition-colors">Home</a>
        <span aria-hidden="true">&bull;</span>
        <span class="text-ink font-semibold" aria-current="page">Portfolio</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-md text-[10px] sm:text-xs font-semibold bg-accent-soft text-accent border border-blue-100">
          <span>Real Client Projects & Transparent Prototypes</span>
        </div>

        <h1 class="text-xl sm:text-3xl lg:text-[34px] font-bold tracking-tight text-ink leading-snug">
          Proof of our work: systems that solve real bottlenecks
        </h1>

        <p class="text-xs sm:text-sm text-body leading-relaxed max-w-prose">
          We believe proof beats claims. Every entry is clearly labelled as a client project, an in-house prototype, or an interactive demo so you always know what is real and tested.
        </p>

        <!-- Filter Chips (Section 9: All | AI | Websites | Marketing | Branding & Design) -->
        <div class="pt-3">
          <span class="block text-xs font-bold uppercase tracking-wider text-ink-muted mb-2">
            Filter by service type:
          </span>
          <div
            class="flex flex-wrap items-center gap-2"
            id="portfolio-filters"
            role="toolbar"
            aria-label="Filter case studies by category"
          >
            {
              categories.map((cat) => {
                const isSelected =
                  (!requestedCategory && cat === 'All') || requestedCategory === cat;
                return (
                  <a
                    href={cat === 'All' ? '/portfolio/' : `/portfolio/?category=${encodeURIComponent(cat)}`}
                    data-filter={cat}
                    class:list={[
                      'filter-chip px-3 sm:px-4 py-1.5 sm:py-2 rounded-md text-xs sm:text-sm font-semibold transition-colors duration-180 min-h-[38px] inline-flex items-center',
                      isSelected
                        ? 'bg-accent text-white shadow-xs border border-transparent active-filter'
                        : 'bg-surface-soft hover:bg-slate-200 text-ink border border-border',
                    ]}
                  >
                    <span>{cat}</span>
                    {cat === 'AI' && (
                      <span class="ml-1.5 text-[10px] px-1.5 py-0.2 rounded bg-blue-800 text-blue-100 font-bold">
                        New
                      </span>
                    )}
                  </a>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key trust facts strip -->
  <TrustStrip />

  <!-- Portfolio Grid Section -->
  <section class="py-10 sm:py-18 bg-surface-soft border-b border-border" aria-label="Case studies grid">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <!-- Active count indicator -->
      <div class="flex items-center justify-between text-xs text-ink-muted pb-2 border-b border-border/80">
        <span id="filter-count">
          Showing <span class="font-bold text-ink" id="visible-count">{sortedItems.length}</span> projects
        </span>
        <span class="hidden sm:inline">
          Status badges: Client project &bull; Pilot &bull; In-house prototype &bull; Demo
        </span>
      </div>

      <!-- Grid of all 15 projects -->
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6"
        id="portfolio-grid"
      >
        {
          sortedItems.map((item) => (
            <div
              class="portfolio-item-wrapper transition-opacity duration-180"
              data-category={item.category}
            >
              <ProofCard
                title={item.title}
                slug={item.slug}
                category={item.category}
                status={item.status}
                year={item.year}
                clientType={item.clientType}
                problem={item.problem}
                solution={item.solution}
                result={item.result}
                stack={item.stack}
                image={item.image}
              />
            </div>
          ))
        }
      </div>

      <!-- Empty state if filter has no items -->
      <div
        id="no-results"
        class="hidden text-center py-12 bg-surface rounded-lg border border-border p-6 space-y-3"
      >
        <p class="text-sm font-semibold text-ink">No projects found in this category.</p>
        <p class="text-xs text-ink-muted">Try clicking "All" above to see our complete portfolio.</p>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="py-10 sm:py-20 bg-surface" aria-label="Book a consultation">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <CtaBand
        headline="Have a project in mind for your business?"
        subheadline="Book a free 30-minute call. We listen to your goals, check feasibility, and send a written fixed-price proposal in 2 working days."
        showForm={true}
      />
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive Enhancement Client Filter (Lightweight, < 30 lines)
  const filterButtons = document.querySelectorAll<HTMLAnchorElement>('.filter-chip');
  const items = document.querySelectorAll<HTMLElement>('.portfolio-item-wrapper');
  const visibleCountEl = document.getElementById('visible-count');
  const noResultsEl = document.getElementById('no-results');

  function applyFilter(selectedCategory: string) {
    let visibleCount = 0;

    items.forEach((item) => {
      const itemCat = item.dataset.category;
      if (selectedCategory === 'All' || itemCat === selectedCategory) {
        item.classList.remove('hidden');
        item.style.opacity = '1';
        visibleCount++;
      } else {
        item.classList.add('hidden');
        item.style.opacity = '0';
      }
    });

    if (visibleCountEl) {
      visibleCountEl.textContent = String(visibleCount);
    }

    if (noResultsEl) {
      if (visibleCount === 0) {
        noResultsEl.classList.remove('hidden');
      } else {
        noResultsEl.classList.add('hidden');
      }
    }

    // Update active button state
    filterButtons.forEach((btn) => {
      const btnCat = btn.dataset.filter;
      if (btnCat === selectedCategory) {
        btn.className =
          'filter-chip px-3 sm:px-4 py-1.5 sm:py-2 rounded-md text-xs sm:text-sm font-semibold transition-colors duration-180 min-h-[38px] inline-flex items-center bg-accent text-white shadow-xs border border-transparent active-filter';
      } else {
        btn.className =
          'filter-chip px-3 sm:px-4 py-1.5 sm:py-2 rounded-md text-xs sm:text-sm font-semibold transition-colors duration-180 min-h-[38px] inline-flex items-center bg-surface-soft hover:bg-slate-200 text-ink border border-border';
      }
    });
  }

  // Intercept click for zero-reload client filtering
  filterButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const cat = btn.dataset.filter || 'All';
      applyFilter(cat);

      // Update URL query string without reloading
      const url = new URL(window.location.href);
      if (cat === 'All') {
        url.searchParams.delete('category');
      } else {
        url.searchParams.set('category', cat);
      }
      history.replaceState(null, '', url.toString());
    });
  });

  // Handle initial page load if query param is set
  const initialParams = new URLSearchParams(window.location.search);
  const initialCat = initialParams.get('category');
  if (initialCat) {
    applyFilter(initialCat);
  }
</script>
